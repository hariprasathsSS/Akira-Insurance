APP_ENV=development
APP_NAME=AKIRA_INSURANCE
API_PREFIX=/api/v1
LOG_LEVEL=INFO
DEMO_AUTH_ENABLED=true

# Database
DATABASE_URL=postgresql+asyncpg://akira:change-me@postgres:5432/akira

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=akira_policy_chunks

# File storage
UPLOAD_DIR=/app/storage/policies
MAX_UPLOAD_MB=15
ALLOWED_UPLOAD_MIME_TYPES=application/pdf

# LLM (leave blank to run in non-LLM mode)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# OpenAI: LLM_PROVIDER=openai  LLM_MODEL=gpt-4o  LLM_API_KEY=sk-...
# Google: LLM_PROVIDER=google   LLM_MODEL=gemini-1.5-pro  LLM_API_KEY=AIza...

# Embeddings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024
VECTOR_SIZE=1024
CHUNK_SIZE=700
CHUNK_OVERLAP_SIZE=100
# OpenAI: EMBEDDING_PROVIDER=openai EMBEDDING_MODEL=text-embedding-3-small EMBEDDING_API_KEY=sk-... EMBEDDING_DIM=1536
# Local: EMBEDDING_PROVIDER=sentence_transformers EMBEDDING_MODEL=BAAI/bge-m3 VECTOR_SIZE=1024

# Langfuse observability
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=true

# Business rules
STP_THRESHOLD_INR=10000
MAX_CHAT_MESSAGE_CHARS=8000
RAG_TOP_K=8
RAG_MIN_SCORE=0.3

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Internal secrets (MUST be changed in any shared environment)
APP_SECRET_KEY=change-this-in-production-not-for-dev-only
